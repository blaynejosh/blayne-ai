# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# The key is read by the API server (server/index.js) only. It is never sent to
# the browser and never appears in the client bundle.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# BLAYNE_MODEL=claude-opus-5
# PORT=8787
